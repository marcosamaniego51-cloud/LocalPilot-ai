# ─────────────────────────────────────────────────────────────
# LocalPilot AI — Environment Variables
# Copy this file to .env (and .env.local for Next.js secrets) and fill in real values.
# See .kiro/specs/local-pilot-ai/design.md for what each integration is used for.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL — Neon/RDS in production, local docker/postgres in dev)
DATABASE_URL="postgresql://localpilot:localpilot@localhost:5432/localpilot?schema=public"

# Redis (Upstash in production, local docker/redis in dev) — used by BullMQ worker
REDIS_URL="redis://localhost:6379"

# Auth.js (NextAuth)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI — AI site copy generation + email auto-reply agent
OPENAI_API_KEY=""

# Google Places API (New) — Prospect discovery (business listings without a website)
# Enable "Places API (New)" in Google Cloud Console for this key.
GOOGLE_PLACES_API_KEY=""

# SendGrid — outreach email sending + Inbound Parse webhook for reply handling
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="hello@localpilot.ai"
SENDGRID_INBOUND_PARSE_WEBHOOK_SECRET=""

# Twilio — phone number provisioning + inbound call control (inbound-only, see design.md Section 11)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Voice AI agent — Retell AI (or Vapi as fallback) for the inbound AI receptionist
RETELL_API_KEY=""
RETELL_WEBHOOK_SECRET=""

# Stripe — subscription billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_DEFAULT_PLAN=""

# App config
NEXT_PUBLIC_APP_DOMAIN="localpilot.ai"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
