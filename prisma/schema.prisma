// LocalPilot AI — Prisma schema
// Mirrors the data model defined in .kiro/specs/local-pilot-ai/design.md (Section 4)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ProspectStatus {
  new
  previewed
  contacted
  replied
  claimed
  dead
}

enum SiteStatus {
  preview
  published
  suspended
}

enum PageType {
  home
  about
  services
  contact
}

enum TenantUserRole {
  owner
  staff
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  canceled
}

enum LeadSource {
  contact_form
  inbound_call
}

enum CallDirection {
  inbound
  outbound
}

enum CallOutcome {
  interested
  not_interested
  callback
  voicemail
  no_answer
  resolved
  transferred
  // Added for Task 8 (inbound receptionist) — outcomes an inbound call
  // to a Tenant's business can resolve to, distinct from the outreach-call
  // outcomes above (which don't apply here since outbound calling is
  // descoped per design.md Section 11).
  message_taken
  appointment_requested
}

enum EmailDirection {
  outbound
  inbound
}

enum EmailThreadStatus {
  open
  flagged_for_human
  closed
}

enum OutreachSequence {
  initial_email_seq
}

enum OutreachStatus {
  active
  paused
  completed
  stopped
  exhausted
}

enum DiscoveryJobStatus {
  pending
  running
  completed
  failed
}

enum SiteEditRequestStatus {
  pending
  applied
  failed
}

// ─────────────────────────────────────────────────────────────
// Discovery & Prospects
// ─────────────────────────────────────────────────────────────

model DiscoveryJob {
  id        String             @id @default(cuid())
  params    Json // { category, location, radiusKm }
  status    DiscoveryJobStatus @default(pending)
  stats     Json? // { scanned, created, duplicates }
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  prospects Prospect[]

  @@map("discovery_jobs")
}

model Prospect {
  id                     String         @id @default(cuid())
  businessName           String
  normalizedBusinessName String
  category               String
  phone                  String?
  normalizedPhone        String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  lat                    Float?
  lng                    Float?
  source                 String         @default("google_places")
  status                 ProspectStatus @default(new)
  doNotContact           Boolean        @default(false)
  doNotCall              Boolean        @default(false)
  discoveryJobId         String?
  discoveryJob           DiscoveryJob?  @relation(fields: [discoveryJobId], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  site          Site?
  tenant        Tenant?
  outreachState OutreachState?
  emailThreads  EmailThread[]
  calls         Call[]

  @@index([normalizedPhone])
  @@index([normalizedBusinessName])
  @@index([status])
  @@map("prospects")
}

model OutreachState {
  id           String           @id @default(cuid())
  prospectId   String           @unique
  prospect     Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequence     OutreachSequence @default(initial_email_seq)
  currentStep  Int              @default(0)
  nextActionAt DateTime?
  status       OutreachStatus   @default(active)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("outreach_states")
}

// ─────────────────────────────────────────────────────────────
// Sites
// ─────────────────────────────────────────────────────────────

model Site {
  id           String     @id @default(cuid())
  prospectId   String?    @unique
  prospect     Prospect?  @relation(fields: [prospectId], references: [id])
  tenantId     String?    @unique
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  slug         String     @unique
  subdomain    String     @unique
  status       SiteStatus @default(preview)
  templateId   String
  colorScheme  Json?
  businessInfo Json? // { hours, services, faq, phone, logoUrl, photos: [] }
  generatedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pages         SitePage[]
  editRequests  SiteEditRequest[]
  customDomains CustomDomain[]

  @@map("sites")
}

model SitePage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageType  PageType
  content   Json // block-based AI-generated content
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([siteId, pageType])
  @@map("site_pages")
}

model SiteEditRequest {
  id        String                @id @default(cuid())
  siteId    String
  site      Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  request   Json // description of requested change
  status    SiteEditRequestStatus @default(pending)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("site_edit_requests")
}

model CustomDomain {
  id                String    @id @default(cuid())
  domain            String    @unique
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Random token the Tenant must publish as a TXT record
  // (_localpilot-verify.<domain>) to prove domain ownership before the
  // domain is attached to Vercel and requests are accepted for it.
  verificationToken String
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([siteId])
  @@map("custom_domains")
}

// ─────────────────────────────────────────────────────────────
// Tenants & Billing
// ─────────────────────────────────────────────────────────────

model Tenant {
  id                      String    @id @default(cuid())
  prospectId              String?   @unique
  prospect                Prospect? @relation(fields: [prospectId], references: [id])
  businessName            String
  normalizedBusinessName  String
  receptionistPhoneNumber String?
  forwardingNumber        String?
  // Retell resource ids for the Tenant's AI receptionist (Task 8). Kept
  // alongside receptionistPhoneNumber rather than in a separate table —
  // there's exactly one receptionist agent per Tenant in v1, so a 1:1
  // set of nullable columns is simpler than a join for no benefit.
  retellLlmId             String?
  retellAgentId           String?
  stripeCustomerId        String?   @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  site               Site?
  users              TenantUser[]
  subscription       Subscription?
  leads              Lead[]
  calls              Call[]
  emailThreads       EmailThread[]
  receptionistConfig ReceptionistConfig?

  @@index([normalizedBusinessName])
  @@map("tenants")
}

model TenantUser {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String         @unique
  passwordHash String?
  role         TenantUserRole @default(owner)
  createdAt    DateTime       @default(now())

  passwordResetTokens PasswordResetToken[]

  @@map("tenant_users")
}

// One-time password-set/reset tokens (Task 7.3). Used for the initial
// "set your password" link sent when a Tenant is first provisioned at
// claim time, and can be reused later for a standard forgot-password
// flow. Stores a hash of the token, never the raw token, so a DB leak
// alone can't be used to take over an account before the link is used or
// expires.
model PasswordResetToken {
  id           String     @id @default(cuid())
  tenantUserId String
  tenantUser   TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@map("password_reset_tokens")
}

// Platform operator/staff accounts — distinct from TenantUser (Requirement
// 9.3). Operators are not scoped to any single Tenant; they access the
// admin/discovery/support views. Kept as a separate table/model rather
// than a role value on TenantUser so an operator can never accidentally
// be resolved as "the tenant user for tenant X" by code that only checks
// tenantId presence.
model OperatorUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("operator_users")
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  planId               String
  status               SubscriptionStatus @default(trialing)
  currentPeriodEnd     DateTime?
  dunningStage         Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Leads, Calls, Email
// ─────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source    LeadSource
  name      String?
  phone     String?
  email     String?
  message   String?
  createdAt DateTime   @default(now())

  calls Call[]

  @@map("leads")
}

model Call {
  id             String        @id @default(cuid())
  direction      CallDirection
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  prospectId     String?
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  providerCallId String?       @unique
  transcript     String?
  outcome        CallOutcome?
  durationSec    Int?
  recordingUrl   String?
  createdAt      DateTime      @default(now())

  @@map("calls")
}

model EmailThread {
  id         String            @id @default(cuid())
  prospectId String?
  prospect   Prospect?         @relation(fields: [prospectId], references: [id])
  tenantId   String?
  tenant     Tenant?           @relation(fields: [tenantId], references: [id])
  subject    String
  status     EmailThreadStatus @default(open)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  messages EmailMessage[]

  @@map("email_threads")
}

model EmailMessage {
  id              String         @id @default(cuid())
  threadId        String
  thread          EmailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction       EmailDirection
  fromAddress     String
  body            String
  aiGenerated     Boolean        @default(false)
  confidenceScore Float?
  createdAt       DateTime       @default(now())

  @@map("email_messages")
}

// ─────────────────────────────────────────────────────────────
// Voice AI receptionist (Task 8) — inbound-only, see design.md Section 11
// for why outbound AI calling was descoped.
// ─────────────────────────────────────────────────────────────

// Persists a Tenant's inbound-call configuration (Requirement 7.5):
// business hours, FAQs, and the personal number to fall back to when the
// AI receptionist can't handle a request (Requirement 7.4). Kept as its
// own model rather than folded into Site.businessInfo (which already
// holds a loosely-typed hours/services/faq blob for the *website*) so the
// receptionist's config has a stable, directly-queryable shape
// independent of whatever the site content generation puts in that JSON
// blob — the two are allowed to say the same thing without being forced
// to be the exact same object.
model ReceptionistConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessHours  Json? // { mon: "9am-5pm", ... } — free-form, Tenant-authored
  faqs           Json? // [{ question, answer }]
  personalNumber String? // fallback transfer target (Requirement 7.4)
  greeting       String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("receptionist_configs")
}

// ─────────────────────────────────────────────────────────────
// Webhook idempotency
// ─────────────────────────────────────────────────────────────

// Generic dedup record for inbound provider webhooks (Requirement 10.3 /
// Task 7.6). Providers (Stripe, Twilio, SendGrid, Retell/Vapi) all retry
// webhook delivery on timeout/5xx, so every webhook handler must be safe
// to receive the same event twice. Keyed by (provider, eventId) rather
// than a bare id, since event-id namespaces are provider-specific and we
// don't want to assume global uniqueness across providers.
model WebhookEvent {
  provider  String
  eventId   String
  type      String
  createdAt DateTime @default(now())

  @@id([provider, eventId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
